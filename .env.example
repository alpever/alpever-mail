PORT=3000

# Public Application URL (used when deployed so email clients load uploaded images)
# Set this to your deployed domain, e.g. https://mail.yourdomain.com or http://YOUR_SERVER_IP:3000
APP_URL=http://localhost:3000

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mass_mailer_db

# Resend API Configuration
RESEND_API_KEY=re_your_api_key_here
DEFAULT_FROM_NAME=AlpEver Mail
DEFAULT_FROM_EMAIL=onboarding@resend.dev
DEFAULT_REPLY_TO=
